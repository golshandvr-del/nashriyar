# Nashriyar — production environment template (ROADMAP phase 11).
# Copy to .env.production (never commit it):  cp .env.example .env.production
# docker-compose.yml loads .env.production into the `app` container.

# Secret used to sign sessions, reader page URLs and CSRF tokens.
# At least 16 characters. Generate once:  openssl rand -base64 48
# If empty, a random secret is generated and stored in the database on first start.
APP_SECRET=

# Optional AI provider (OpenAI-compatible). Can also be set by the super admin in the panel.
# The key is only used server-side and never sent to browsers.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# PDF → page images: by default the server converts with poppler's pdftoppm when it is installed
# (the Docker image includes it). Set to "browser" to always convert in the uploader's browser (pdf.js).
PDF_RENDERER=

# In-process scheduler (self-hosted): maintenance every 15 minutes (analytics rollup, reminders,
# purge of expired sessions/cache/login windows) + one database backup per day at BACKUP_HOUR
# (server local time; -1 disables the daily backup). CRON=off disables the scheduler entirely
# (use the host crontab with --maintenance / --backup instead).
CRON=
BACKUP_HOUR=3

# Days of database/files snapshots kept by `--backup` / `--backup-files` (default 30).
BACKUP_KEEP_DAYS=30
# Optional second directory on a separate disk / NFS / rclone mount to mirror every backup for off-server protection.
BACKUP_OFFSITE_DIR=

# Network / paths (defaults shown). docker-compose.yml overrides DATA_DIR/PORT/HOST;
# the systemd setup in docs/OPERATIONS.md reads them from this file.
PORT=3000
HOST=0.0.0.0
DATA_DIR=data
STATIC_DIR=dist
