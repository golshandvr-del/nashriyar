# Nashriyar — environment template for the self-hosted server (copy to .env.production; never commit real values).

# HMAC signing secret for sessions, signed media URLs and reader tokens (>= 16 chars).
# If empty, a random secret is generated once and stored in the database settings table.
# Generate: openssl rand -base64 48
APP_SECRET=

# Network / paths (defaults shown; docker-compose already sets DATA_DIR/PORT/HOST)
PORT=3000
HOST=0.0.0.0
DATA_DIR=data
STATIC_DIR=dist

# Optional AI layer (OpenAI-compatible endpoint). Leave empty to keep AI features hidden.
# The super admin can also enable/disable AI and set budgets from /admin/settings.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
