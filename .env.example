# Nashriyar — production environment template (ROADMAP phase 11).
# Copy to .env.production (never commit it):  cp .env.example .env.production
# docker-compose.yml loads .env.production into the `app` container.

# Secret used to sign sessions, reader page URLs and CSRF tokens.
# Generate once:  openssl rand -hex 32
# If empty, a random secret is generated and stored in the database on first start.
APP_SECRET=

# Optional AI provider (OpenAI-compatible). Can also be set by the super admin in the panel.
# The key is only used server-side and never sent to browsers.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Days of database snapshots kept by `node server-dist/node.mjs --backup` (default 30).
BACKUP_KEEP_DAYS=30

# Normally set by docker-compose.yml; only needed when running the Node server directly.
# PORT=3000
# HOST=0.0.0.0
# DATA_DIR=./data
# STATIC_DIR=dist
