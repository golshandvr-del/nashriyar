{
  "name": "nashriyar",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/build-server.mjs",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node server-dist/node.mjs",
    "seed": "node server-dist/node.mjs --seed",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-e2e.mjs",
    "test:load": "node tests/load.mjs",
    "backup": "node server-dist/node.mjs --backup",
    "dev:cf": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "db:migrate:local": "wrangler d1 migrations apply nashriyar-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply nashriyar-production --remote",
    "deploy:cf": "npm run build && wrangler pages deploy dist --project-name nashriyar"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "echarts": "^6.1.0",
    "hono": "^4.13.14",
    "lucide-react": "^1.64.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "vazirmatn": "^33.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  },
  "version": "1.0.0",
  "private": true
}
